# Firebase dependency cache (HUGE FILES)
Assets/GeneratedLocalRepo/

# Firebase native binaries that can exceed GitHub 100MB limit
Assets/Firebase/Plugins/x86_64/

# Auto downloaded Android libraries
Assets/Plugins/Android/*.aar
Assets/Plugins/Android/*.jar

# Gradle intermediates
Assets/Plugins/Android/.gradle/

# Temporary gradle exports
Assets/Plugins/Android/build/
Assets/Plugins/Android/out/

